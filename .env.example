# Copy to .env and fill in. Never commit .env.
NEBIUS_API_KEY=
TAVILY_API_KEY=

# Local database credentials (set a strong password anywhere other than your laptop)
DB_USER=dawaguard
DB_PASSWORD=

# Enables /api/diagnostics/* smoke tests, which spend API credits. Never true on a public deployment.
DIAGNOSTICS_ENABLED=false

# WhatsApp (Meta Cloud API). From your Meta app: WhatsApp > API Setup, and App settings > Basic for the secret.
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
# Any long random string; paste the same value into the Meta webhook settings.
WHATSAPP_VERIFY_TOKEN=
# Approved Utility template for alerts sent more than 24 hours after the family last wrote.
# Body: "DawaGuard alert: CDSCO has flagged {{1}}, batch {{2}}, saved in your family medicine cabinet. Reply CABINET to see details and what to do."
WHATSAPP_ALERT_TEMPLATE=dawaguard_batch_alert
WHATSAPP_TEMPLATE_LANGUAGE=en

# Unlocks POST /api/demo/cdsco-alert (simulated CDSCO alert for the demo video). Leave blank to disable.
DEMO_TOKEN=

# Optional model overrides (defaults are in application.yml)
# MODEL_VISION=nvidia/Nemotron-3.5-Super-VL
# MODEL_REASONING=nvidia/Nemotron-3-Ultra-550b-a55b
# MODEL_FAST=nvidia/Nemotron-3_5-Lightning
