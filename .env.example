# Copy to .env and fill in. Never commit .env.
NEBIUS_API_KEY=
TAVILY_API_KEY=

# Local database credentials (set a strong password anywhere other than your laptop)
DB_USER=dawaguard
DB_PASSWORD=

# Enables /api/diagnostics/* smoke tests, which spend API credits. Never true on a public deployment.
DIAGNOSTICS_ENABLED=false

# Optional model overrides (defaults are in application.yml)
# MODEL_VISION=nvidia/Nemotron-3.5-Super-VL
# MODEL_REASONING=nvidia/Nemotron-3-Ultra-550b-a55b
# MODEL_FAST=nvidia/Nemotron-3_5-Lightning
